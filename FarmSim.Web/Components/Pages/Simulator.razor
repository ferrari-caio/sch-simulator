@page "/simulator"
@inject IJSRuntime JS

<h1>Harvest Simulator</h1>

<div id="map" style="width:100%;height:648px;" @ref="mapDiv"></div>

@code {
    private ElementReference mapDiv;
    private bool _mapInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapInitialized) return;

        try
        {
            // ✅ 1) Load google maps API once.
            await JS.InvokeVoidAsync("maps.ensureLoaded", "AIzaSyDV39NHnTb4oJh1hFyeXJ8_eW8_942VZek");
            // ✅ 2) Create the map
            await JS.InvokeVoidAsync("maps.initializeMap", mapDiv, -23.55052, -46.633308, 12);
            _mapInitialized = true;
            await JS.InvokeVoidAsync("console.log", "Simulator: map initialized");
        }
        catch (InvalidOperationException)
        {
            // If prerendering (SSR), JS interop is not yet available.
            // Do nothing: when the Blazor circuit connects, the component will render again
            // and this will run normally.
        }
        catch (JSException ex)
        {
            // If it falls here, usually it is:
            // - maps.js not loaded
            // - error in the key / referer block
            // - some exception in JS
            Console.Error.WriteLine(ex);
        }
    }
}